# apps/web settings (ADR 0012). Copy to apps/web/.env, which git ignores. Names only here: never commit values.
# Vite builds every VITE_* value into public JavaScript, so nothing secret ever goes in this file.

# The Clerk instance's publishable key (pk_test_... for a development instance). Public by design. The build also
# reads the Clerk Frontend API host from it for the Content Security Policy.
VITE_CLERK_PUBLISHABLE_KEY=
# The api's origin, with no path. Locally, the api on port 3001.
VITE_API_URL=
# Optional: the https address of the Android app's APK (the asset on the repository's releases page). Set, the landing
# page offers "Get the Android app"; empty, it doesn't mention the app.
VITE_ANDROID_APP_URL=

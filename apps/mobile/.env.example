# apps/mobile settings (ADR 0016). Copy to apps/mobile/.env, which git ignores. Names only here: never commit values.
# Expo builds every EXPO_PUBLIC_* value into the JavaScript, so nothing secret ever goes in this file.

# The Clerk instance's publishable key (pk_test_... for a development instance), the same instance as the api's
# CLERK_JWT_KEY. Public by design.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# The api's origin, with no path. For a phone on your Wi-Fi, this computer's LAN address, http://192.168.x.x:3001,
# not localhost; for the deployed api, its https origin.
EXPO_PUBLIC_API_URL=

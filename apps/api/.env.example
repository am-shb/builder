# apps/api settings (docs/adr/0010-api-stack.md). Copy to apps/api/.env, which git ignores. Never commit values.
# Leave a group empty to turn that part off: its routes answer 503 instead of the server refusing to start.

# Port to listen on. Default 3001 (the engine uses 3000).
PORT=

# Clerk: set both or neither. CLERK_JWT_KEY is the PEM public key from the Clerk dashboard (API keys > JWT public
# key), so tokens are checked with no call to Clerk. A one-line value with literal \n is fine.
CLERK_JWT_KEY=
# The web app's origins, comma-separated, e.g. http://localhost:5173,https://app.example.com
CLERK_AUTHORIZED_PARTIES=

# The engine's /internal/* boundary (ADR 0008): set both or neither. The token is shared with the engine and is at
# least 32 characters, e.g. from `openssl rand -hex 32`. Never commit.
ENGINE_INTERNAL_URL=
ENGINE_INTERNAL_TOKEN=

# Per-session limits until billing exists: set both or neither. Values are still to be decided (D5 in
# docs/plans/api-first-slice.md).
DEFAULT_MAX_USD=
DEFAULT_MAX_MINUTES=

# SurrealDB (docs/adr/0011-surrealdb.md), namespace builder, database api. Empty SURREAL_URL: SurrealDB runs in this
# process, in SURREAL_PATH (not allowed when NODE_ENV=production). Apply migrations to a server with
# `npm run migrate -w @builder/api`.
# A ws:// or wss:// URL: the SurrealDB Cloud instance in production, or a local `surreal start`.
SURREAL_URL=
# Required with SURREAL_URL: the user to sign in as, and its password. Never commit the password.
SURREAL_USER=
SURREAL_PASS=
# Optional: what kind of user SURREAL_USER is. Empty = database: a user defined on namespace builder, database api
# (SurrealDB Cloud). root = a root user, as on a local `surreal start --user root --pass ...`.
SURREAL_AUTH=
# Optional: the in-process database's folder when SURREAL_URL is empty. Empty = data/surreal (git-ignored).
SURREAL_PATH=

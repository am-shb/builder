# Recall region for workspace Meet2Build. Keep the API key and secret from the same region.
RECALL_REGION=us-west-2
# REST API key (Recall dashboard > Developers > API Keys). Never commit.
RECALL_API_KEY=
# Workspace verification secret (whsec_...). Signs realtime webhooks. Never commit.
RECALL_WEBHOOK_VERIFICATION_SECRET=
# Public HTTPS origin that routes to this server, e.g. the cloudflared or ngrok URL. No trailing slash.
PUBLIC_API_BASE_URL=
PORT=3000
# Optional: bot size. Empty = web_4_core (the default, for smooth shared-screen animation). Set to web for
# Recall's plain web bot (250 millicores, cheapest) or web_gpu. Larger variants cost more per hour (see Recall
# Output Media docs). Applies to newly created bots only.
BOT_VARIANT=
# Optional: Postgres connection string. Never commit. Empty = PGlite (Postgres in this process) in PGLITE_DIR.
# Apply migrations first with `npm run migrate -w @builder/engine`. `npm run local` always uses PGlite.
DATABASE_URL=
# Optional: PGlite data directory when DATABASE_URL is empty. Empty = data/pg (data/local-pg for npm run local).
PGLITE_DIR=
# Optional: OpenRouter key for all model access (conversation + build models, TTS). Never commit.
# Empty = the app runs listen-only (transcript only, no agent).
OPENROUTER_API_KEY=
# Optional: ElevenLabs voice for elevenlabs/eleven-v4-turbo, one of the model page's voices, e.g. george
# (full list: test/fixtures/openrouter-tts.md). Empty = Builder's lines go to meeting chat, not voice.
TTS_VOICE=

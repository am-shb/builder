# Recall region for workspace Meet2Build. Keep the API key and secret from the same region.
RECALL_REGION=us-west-2
# REST API key (Recall dashboard > Developers > API Keys). Never commit.
RECALL_API_KEY=
# Workspace verification secret (whsec_...). Signs realtime webhooks. Never commit.
RECALL_WEBHOOK_VERIFICATION_SECRET=
# Public HTTPS origin that routes to this server, e.g. the cloudflared or ngrok URL. No trailing slash. Empty on
# Render: the engine uses RENDER_EXTERNAL_URL, which Render sets.
PUBLIC_API_BASE_URL=
PORT=3000
# Optional: the shared token for POST /internal/sessions, the api's way to start sessions (docs/adr/0008). The same
# value as the api's ENGINE_INTERNAL_TOKEN, at least 32 characters, e.g. from `openssl rand -hex 32`. Never commit.
# Empty = the /internal routes are off (404).
ENGINE_INTERNAL_TOKEN=
# Optional: bot size. Empty = web_4_core (the default, for smooth shared-screen animation). Set to web for
# Recall's plain web bot (250 millicores, cheapest) or web_gpu. Larger variants cost more per hour (see Recall
# Output Media docs). Applies to newly created bots only.
BOT_VARIANT=
# Optional: SurrealDB server, ws:// or wss:// (production: wss://<instance-id>.<region>.surreal.cloud). Empty =
# SurrealDB runs in this process, in SURREAL_PATH. Apply migrations first with `npm run migrate -w @builder/engine`.
# `npm run local` never uses it.
SURREAL_URL=
# Required with SURREAL_URL: the user to sign in as, and its password. Never commit the password.
SURREAL_USER=
SURREAL_PASS=
# Optional: what kind of user SURREAL_USER is. Empty = database: a user defined on namespace builder, database engine
# (SurrealDB Cloud's setup). It needs the OWNER role there, because migrations define sequences, which an EDITOR
# can't. Set to root for a root user, as on a local `surreal start --user root --pass ...`.
SURREAL_AUTH=
# Optional: the in-process database's folder when SURREAL_URL is empty. Empty = data/surreal (data/local-surreal
# for npm run local).
SURREAL_PATH=
# Optional: OpenRouter key for all model access (conversation + build models, TTS). Never commit.
# Empty = the app runs listen-only (transcript only, no agent).
OPENROUTER_API_KEY=
# Optional: ElevenLabs voice for elevenlabs/eleven-v4-turbo, one of the model page's voices, e.g. george
# (full list: test/fixtures/openrouter-tts.md). Empty = Builder's lines go to meeting chat, not voice.
TTS_VOICE=

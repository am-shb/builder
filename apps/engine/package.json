{
  "name": "@builder/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Builder: a Recall.ai meeting bot that listens to a Google Meet, steers the group, and live-builds a clickable prototype on a screenshared stage.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "local": "node src/server.ts --local",
    "smoke": "node src/server.ts --smoke",
    "replay": "node scripts/replay.ts",
    "migrate": "node src/db/migrate.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p .",
    "check": "npm run typecheck && npm test && npm run smoke",
    "tunnel": "cloudflared tunnel --url http://localhost:3000"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@electric-sql/pglite": "^0.5.10",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11"
  }
}

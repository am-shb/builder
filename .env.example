# Recall region for workspace Meet2Build. Keep the API key and secret from the same region.
RECALL_REGION=us-west-2
# REST API key (Recall dashboard > Developers > API Keys). Never commit.
RECALL_API_KEY=
# Workspace verification secret (whsec_...). Signs realtime webhooks. Never commit.
RECALL_WEBHOOK_VERIFICATION_SECRET=
# Public HTTPS origin that routes to this server, e.g. the cloudflared or ngrok URL. No trailing slash.
PUBLIC_API_BASE_URL=
PORT=3000
# Optional: larger bot for smoother shared-screen animation. Empty = default "web" (250 millicores).
# web_4_core costs more per hour (see Recall Output Media docs). Applies to newly created bots only.
BOT_VARIANT=
# Optional: OpenRouter key for all model access (conversation + build models, TTS). Never commit.
# Empty = the app runs listen-only (transcript only, no agent).
OPENROUTER_API_KEY=
# Optional: ElevenLabs voice id from the elevenlabs/eleven-v4-turbo OpenRouter model page.
TTS_VOICE=
